# Archivo de configuración de variables de entorno
# FERROANDES Perú - Sistema de Sincronización Documental
# 
# INSTRUCCIONES:
# 1. Copiar este archivo como .env
# 2. Reemplazar los valores vacíos con las credenciales reales
# 3. Nunca compartir este archivo ni subirlo a repositorio público
# 4. Asegurar permisos de lectura restringida (400)

# ========== CONFIGURACIÓN SHAREPOINT ==========
SHAREPOINT_URL=https://ferroandesperu.sharepoint.com
SHAREPOINT_SITE=https://ferroandesperu.sharepoint.com/sites/RepositorioDocumental
SHAREPOINT_USER=usuario@ferroandesperu.sharepoint.com
SHAREPOINT_PASSWORD=
SHAREPOINT_DOC_LIBRARY=Documentos Compartidos/

# ========== CONFIGURACIÓN AWS S3 ==========
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=ferroandes-documentos-s3
S3_BUCKET_PREFIX=repositorio-sincronizado/

# ========== CONFIGURACIÓN LOCAL ==========
LOCAL_TEMP_DIR=C:/temp/ferroandes-sync
LOCAL_ARCHIVE_DIR=C:/archive/ferroandes-docs

# ========== CONFIGURACIÓN DE EJECUCIÓN ==========
LOG_LEVEL=INFO
LOG_FILE=./logs/sync.log
MAX_RETRIES=3
TIMEOUT_SECONDS=300

# ========== INFORMACIÓN DE LA EMPRESA ==========
EMPRESA=FERROANDES Perú
PROYECTO=Sincronización Documental
VERSION=1.0.0
CONTACTO_SOPORTE=ti-infraestructura@ferroandesperu.com
